[Domain]
Name=Miryu GRUB2 Boot Config
Icon=system-boot-manager
URL=https://github.com/evernightvista/miryu-grub-config

[org.miryugaming.grubconfig.save]
Name=Save GRUB2 settings
Name[zh_CN]=保存 GRUB2 设置
Name[zh_TW]=儲存 GRUB2 設定
Name[ja]=GRUB2 設定を保存
Name[de]=GRUB2-Einstellungen speichern
Name[ko]=GRUB2 설정 저장
Name[fr]=Enregistrer les paramètres GRUB2
Description=Authentication is required to save GRUB2 settings and regenerate the bootloader configuration.
Description[zh_CN]=保存 GRUB2 设置并重新生成引导加载器配置需要进行身份验证。
Description[zh_TW]=儲存 GRUB2 設定並重新產生開機載入程式設定需要進行身分驗證。
Description[ja]=GRUB2 設定を保存し、ブートローダー設定を再生成するには認証が必要です。
Description[de]=Zum Speichern der GRUB2-Einstellungen und zum Neuerstellen der Bootloader-Konfiguration ist eine Authentifizierung erforderlich.
Description[ko]=GRUB2 설정을 저장하고 부트로더 구성을 다시 생성하려면 인증이 필요합니다.
Description[fr]=Une authentification est requise pour enregistrer les paramètres GRUB2 et régénérer la configuration du chargeur d'amorçage.
Policy=auth_admin
Persistence=session
